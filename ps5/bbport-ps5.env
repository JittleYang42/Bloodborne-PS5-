# bbport on the PS5: settings read at every start (KEY=VALUE, # comments).
# The same environment run.py gives the game on a PC; anything not set here takes the default.

# Frame rate: 60 (the 60 FPS++ patch) or uncap (Uncapped FPS++, the display at 120 Hz where
# your TV accepts it, frame cap 120).
BB_FPS=60

# The scene renders at 1916x1078 and FSR 3.1 upscales it to 4K. These must match the patches
# prepare-game.sh made (BB_PS5_RENDER_RES / BB_PS5_OUTPUT_RES there).
BB_RENDER_RES=1916x1078
BB_OUTPUT_RES=3840x2160
BB_UPSCALER=fsr3

# A TV that only takes 1080p: the swapchain follows the display's real mode either way.
#BB_DISPLAY_RES=1920x1080

# Diagnostics for test runs (written to bbport/last_run.log):
#BB_FPS_LOG=1
#BB_FRAME_STATS=1
#BB_GPU_LOG=1
