# bbport on the PS5: settings read at every start (KEY=VALUE, # comments).
# The same environment run.py gives the game on a PC; anything not set here takes the default.

# Frame rate: 60 (the 60 FPS++ patch) or uncap (Uncapped FPS++, the display at 120 Hz where
# your TV accepts it, frame cap 120).
BB_FPS=60

# Output resolution: auto (the default) upscales to whatever the TV or monitor runs at: 1080p,
# 1440p or 4K. Set one yourself to trade sharpness for frame rate, e.g. 1440p on a 4K TV:
#BB_OUTPUT_RES=2560x1440
#BB_OUTPUT_RES=1920x1080
#BB_OUTPUT_RES=3840x2160
BB_OUTPUT_RES=auto

# The display mode itself: the largest the display offers, unless this names another one.
#BB_DISPLAY_RES=2560x1440

# The scene renders at 1916x1078 (must match the patches prepare-game.sh made); FSR 3.1
# upscales it to the output resolution.
BB_RENDER_RES=1916x1078
BB_UPSCALER=fsr3

# Diagnostics for test runs (written to bbport/last_run.log):
#BB_FPS_LOG=1
#BB_FRAME_STATS=1
#BB_GPU_LOG=1
